# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ── Project-specific ───────────────────────────────────────────────────────

# Local preview tooling (build/web static server + rebuild helper). These are
# scratch scripts for driving the app in a browser during development, not
# part of the app itself.
/serve.js
/rebuild.sh

# Machine-specific launch config — hardcodes an absolute Flutter path and
# points at serve.js. Anything shared in .claude/ can still be committed.
/.claude/launch.json
/.claude/settings.local.json

# Claude Design export artifacts. Braidflow.dc.html is kept as the design
# spec this app was built from; these two are runtime scaffolding for the
# canvas prototype and are unused by the Flutter app.
/design_source/support.js
/design_source/ios-frame.jsx
/design_source/.thumbnail

# ── Secrets & signing ──────────────────────────────────────────────────────
# android/.gitignore covers key.properties and keystores inside android/, but
# only inside android/. These catch a stray credential anywhere in the tree.
.env
.env.*
!.env.example
**/*.jks
**/*.keystore
**/*.p12
**/*.cer
**/*.mobileprovision
**/service-account*.json

# ── Generated / developer-local ────────────────────────────────────────────
# Regenerated by `flutter pub get` whenever a plugin is added. The root ignore
# ships .flutter-plugins-dependencies but not its older sibling.
.flutter-plugins

# Local-only dependency overrides and DevTools preferences.
pubspec_overrides.yaml
devtools_options.yaml

# Flutter Version Management, if it gets adopted later.
.fvm/
.fvmrc
